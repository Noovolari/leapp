#!/usr/bin/env node

// The build flavor comes from package.json (leappFlavor: dev in the repository, prod in release
// builds) unless LEAPP_FLAVOR is already set. Core reads it, so a dev CLI talks only to a dev desktop app.
if (!process.env.LEAPP_FLAVOR) {
  const leappFlavor = require("../package.json").leappFlavor;
  if (leappFlavor) {
    process.env.LEAPP_FLAVOR = leappFlavor;
  }
}

const oclif = require("@oclif/core");

oclif.execute({ dir: __dirname });
