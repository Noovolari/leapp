{
  "name": "@noovolari/leapp-cli",
  "description": "Leapp's Command Line Interface\n\nIt relies on Leapp Core, which encapsulates the domain logic.\n\nFor more information about the project visit the [site](www.leapp.cloud).",
  "version": "0.1.65",
  "leappFlavor": "dev",
  "author": {
    "name": "Noovolari",
    "email": "info@noovolari.com"
  },
  "bin": {
    "leapp": "./bin/run"
  },
  "bugs": "https://github.com/Noovolari/leapp/issues",
  "dependencies": {
    "@aws-sdk/client-ec2": "3.1163.0",
    "@aws-sdk/client-ssm": "3.1163.0",
    "@aws-sdk/client-sso": "3.1163.0",
    "@aws-sdk/client-sso-oidc": "3.1163.0",
    "@aws-sdk/client-sts": "3.1163.0",
    "@azure/msal-node": "7.2.0",
    "@noovolari/leapp-core": "file:../core",
    "@oclif/core": "5.1.11",
    "@oclif/plugin-help": "7.0.6",
    "@smithy/node-http-handler": "4.14.2",
    "@smithy/protocol-http": "5.6.2",
    "@smithy/util-retry": "4.6.2",
    "axios": "1.21.0",
    "class-transformer": "0.5.1",
    "copy-dir": "1.3.0",
    "crypto-js": "4.2.0",
    "date-fns": "4.4.0",
    "folder-hash": "4.1.4",
    "follow-redirects": "1.16.2",
    "fs-extra": "11.4.1",
    "http-proxy-agent": "7.0.2",
    "https-proxy-agent": "7.0.6",
    "inquirer": "14.2.5",
    "js-ini": "1.5.1",
    "js-yaml": "3.15.2",
    "keytar": "7.9.0",
    "natural-orderby": "5.0.0",
    "node-fetch": "2.7.0",
    "node-ipc": "9.2.1",
    "node-machine-id": "1.1.12",
    "open": "11.0.4",
    "reflect-metadata": "0.2.2",
    "require-module": "0.1.0",
    "rimraf": "6.1.4",
    "rxjs": "7.8.2",
    "semver": "7.8.6",
    "string-width": "4.2.3",
    "sudo-prompt": "9.2.1",
    "tar": "7.5.22",
    "tslib": "2.9.1",
    "uuid": "11.1.1"
  },
  "devDependencies": {
    "@babel/core": "8.1.0",
    "@babel/plugin-proposal-decorators": "8.0.2",
    "@babel/plugin-transform-class-properties": "8.0.1",
    "@babel/preset-env": "8.0.7",
    "@babel/preset-typescript": "8.0.7",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@types/jest": "30.0.0",
    "@types/js-yaml": "3.12.10",
    "@types/node": "26.6.6",
    "@types/node-ipc": "9.2.3",
    "gushio": "0.7.5",
    "jest": "30.5.2",
    "oclif": "6.0.15",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "dirname": "oex",
  "engines": {
    "node": ">=22.13.0"
  },
  "files": [
    "/bin",
    "/dist",
    "/npm-shrinkwrap.json",
    "/oclif.manifest.json",
    "src/dpapi-addon",
    "binding.gyp"
  ],
  "homepage": "https://github.com/noovolari/leapp",
  "keywords": [
    "oclif"
  ],
  "main": "dist/index.js",
  "oclif": {
    "bin": "leapp",
    "commands": "./dist/commands",
    "plugins": [
      "@oclif/plugin-help"
    ],
    "topicSeparator": " ",
    "topics": {
      "idp-url": {
        "description": "SAML 2.0 Identity providers URL management"
      },
      "integration": {
        "description": "Leapp Integrations management"
      },
      "profile": {
        "description": "Leapp AWS Multi-profile management"
      },
      "region": {
        "description": "Leapp regions management"
      },
      "session": {
        "description": "Sessions management"
      }
    },
    "macos": {
      "identifier": "cloud.leapp"
    }
  },
  "repository": "noovolari/leapp",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepare-docs": "gushio gushio/replace-header-cli-index-doc.js",
    "clean": "gushio gushio/target-clean.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "prepack": "gushio gushio/target-build.js && oclif manifest && oclif readme --multi --dir scopes",
    "rebuild-core-and-prepack": "cd ../core && npm run build && cd ../cli && gushio gushio/target-build.js && oclif manifest && oclif readme --multi --dir scopes",
    "release-homebrew": "gushio gushio/target-brew-release.js",
    "release-npm": "gushio gushio/target-npm-release.js",
    "run-plugin": "./bin/run session run-aws-credential-plugin",
    "debug-session-list": "./bin/run session start"
  },
  "types": "dist/index.d.ts"
}
