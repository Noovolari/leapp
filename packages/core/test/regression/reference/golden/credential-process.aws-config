
[default]
region=eu-central-1
output=json

[profile foreign-sso]
sso_session=corp
sso_account_id=111111111111
sso_role_name=ReadOnly
region=us-west-2

[sso-session corp]
sso_start_url=https://corp.example.awsapps.com/start
sso_region=us-east-1
sso_registration_scopes=sso:account:access

[profile ls-iam-user]
credential_process=leapp session generate session-iam-user
region=eu-west-1

[profile ls-iam-user-mfa]
credential_process=leapp session generate session-iam-user-mfa
region=eu-central-1

[profile ls-federated]
credential_process=leapp session generate session-federated
region=us-east-1

[profile ls-chained]
credential_process=leapp session generate session-chained
region=us-west-2

[profile ls-sso]
credential_process=leapp session generate session-sso
region=eu-west-1