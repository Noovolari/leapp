{
  "extends": "../../tsconfig.json",
  "compileOnSave": false,
  "compilerOptions": {
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "experimentalDecorators": true,
    "lib": [
      "ES2019",
      "DOM"
    ],
    "module": "node20",
    "moduleResolution": "nodenext",
    "strict": false,
    "sourceMap": true,
    "target": "ES2019",
    "typeRoots": [
      "./node_modules/@types"
    ],
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "rootDir": "./src",
    "outDir": "./dist"
  },
  "include": [
    "./src/**/*.ts"
  ],
  "exclude": [
    "./dist/**",
    "./gushio/**",
    "**/*.test.ts",
    "**/*.spec.ts",
    "**/cdk.out/**/*"
  ]
}
